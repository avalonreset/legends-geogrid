DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# Server-side only. Enable Map Tiles API and restrict this key to that API.
# Selecting a Google map authorizes billed interactive map requests.
# Never prefix this key with VITE_; browser bundles must not contain it.
GOOGLE_MAP_TILES_API_KEY=

# Optional browser-map override. If you change the tile service, supply the
# attribution required by that provider as HTML.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
