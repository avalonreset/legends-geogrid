{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avalonreset/legends-geogrid/blob/main/docs/geogrid-viewer-v1.schema.json",
  "title": "geogrid-viewer/v1",
  "description": "Lean report model for the GeoGrid report viewer. Shares are fractions from 0 to 1. Ranks are whole numbers where 1 is best; null means not found.",
  "type": "object",
  "required": ["schema", "business", "scan", "points", "scores", "zones", "competitors"],
  "properties": {
    "schema": { "const": "geogrid-viewer/v1" },
    "business": {
      "type": "object",
      "required": ["name", "lat", "lng"],
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "scan": {
      "type": "object",
      "required": ["id", "keyword", "gridSize", "radiusM", "createdAt", "device"],
      "properties": {
        "id": { "type": "string" },
        "keyword": { "type": "string" },
        "gridSize": { "type": "integer", "minimum": 1 },
        "radiusM": { "type": "number", "exclusiveMinimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "device": { "type": "string" }
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/point" }
    },
    "scores": { "$ref": "#/$defs/scores" },
    "zones": {
      "type": "object",
      "required": ["rings", "quadrants"],
      "properties": {
        "rings": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
        "quadrants": { "type": "array", "items": { "$ref": "#/$defs/zone" } }
      }
    },
    "competitors": { "type": "array", "items": { "$ref": "#/$defs/competitor" } },
    "delta": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "previousScanId": { "type": "string" },
            "previousCreatedAt": { "type": "string", "format": "date-time" },
            "scores": { "$ref": "#/$defs/scoreChanges" },
            "improved": { "type": "integer", "minimum": 0 },
            "declined": { "type": "integer", "minimum": 0 },
            "unchanged": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "zoneCompetitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["zoneId", "top"],
        "properties": {
          "zoneId": { "type": "string" },
          "top": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "presenceShare": { "$ref": "#/$defs/share" },
                "top3Share": { "$ref": "#/$defs/share" },
                "outrankShare": { "$ref": "#/$defs/share" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "share": { "type": "number", "minimum": 0, "maximum": 1 },
    "rankOrNull": { "type": ["number", "null"], "minimum": 1 },
    "point": {
      "type": "object",
      "required": ["row", "col", "lat", "lng", "rank", "label", "heat"],
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "col": { "type": "integer", "minimum": 0 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "rank": { "type": ["integer", "null"], "minimum": 1 },
        "label": { "type": "string" },
        "heat": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "scores": {
      "type": "object",
      "required": ["foundShare", "solv", "visibleShare", "arp", "atrp", "centerRank"],
      "properties": {
        "foundShare": { "$ref": "#/$defs/share" },
        "solv": { "$ref": "#/$defs/share" },
        "visibleShare": { "$ref": "#/$defs/share" },
        "arp": { "$ref": "#/$defs/rankOrNull" },
        "atrp": { "$ref": "#/$defs/rankOrNull" },
        "centerRank": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "scoreChanges": {
      "type": "object",
      "properties": {
        "foundShare": { "type": ["number", "null"] },
        "solv": { "type": ["number", "null"] },
        "visibleShare": { "type": ["number", "null"] },
        "arp": { "type": ["number", "null"] },
        "atrp": { "type": ["number", "null"] },
        "centerRank": { "type": ["number", "null"] }
      }
    },
    "zone": {
      "type": "object",
      "required": ["id", "label", "points", "foundShare", "avgRank"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "points": { "type": "integer", "minimum": 0 },
        "foundShare": { "$ref": "#/$defs/share" },
        "avgRank": { "$ref": "#/$defs/rankOrNull" }
      }
    },
    "competitor": {
      "type": "object",
      "required": ["name", "top3Share", "outrankShare", "avgRank", "presenceShare"],
      "properties": {
        "name": { "type": "string" },
        "top3Share": { "$ref": "#/$defs/share" },
        "outrankShare": { "$ref": "#/$defs/share" },
        "avgRank": { "$ref": "#/$defs/rankOrNull" },
        "presenceShare": { "$ref": "#/$defs/share" }
      }
    }
  }
}
